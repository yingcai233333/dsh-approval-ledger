{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yingcai233333/dsh-approval-ledger/schema/audit-v1.json",
  "title": "Approval Ledger audit record (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "callId",
    "tool",
    "risk",
    "outcome",
    "time"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "callId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "planId": {
      "type": "string",
      "maxLength": 128
    },
    "itemId": {
      "type": "string",
      "maxLength": 128
    },
    "tool": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "risk": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "mode": {
      "type": "string",
      "maxLength": 64
    },
    "targetHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "targetSummary": {
      "type": "string",
      "maxLength": 200
    },
    "matchedBy": {
      "type": "string",
      "maxLength": 160
    },
    "outcome": {
      "enum": [
        "allowed-once",
        "rejected",
        "cancelled",
        "unavailable"
      ]
    },
    "matcherVersion": {
      "type": "integer",
      "minimum": 1
    },
    "riskPolicyVersion": {
      "type": "integer",
      "minimum": 1
    },
    "time": {
      "type": "integer",
      "minimum": 0
    }
  }
}
