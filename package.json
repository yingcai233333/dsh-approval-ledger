{
  "name": "dsh-approval-ledger",
  "version": "0.0.1",
  "private": false,
  "description": "Batch approvals with a risk gate and an auditable decision ledger for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "author": "yingcai233333",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yingcai233333/dsh-approval-ledger.git"
  },
  "homepage": "https://github.com/yingcai233333/dsh-approval-ledger#readme",
  "bugs": {
    "url": "https://github.com/yingcai233333/dsh-approval-ledger/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "approval",
    "audit",
    "security"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "Approval Ledger",
    "summary": "Batch approvals with a risk gate and an auditable decision ledger.",
    "categories": [
      "安全",
      "效率"
    ],
    "surfaces": [
      "host"
    ],
    "capabilities": {
      "provides": [
        "tool:request_approvals",
        "tool:ask_choices"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2",
      "node": ">=22"
    },
    "permissions": {
      "network": []
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint src test"
  }
}
